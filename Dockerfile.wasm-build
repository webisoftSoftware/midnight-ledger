FROM rust:1.91-slim

RUN apt-get update && apt-get install -y pkg-config libssl-dev curl clang && \
    rustup target add wasm32-unknown-unknown && \
    cargo install wasm-pack

WORKDIR /src
COPY . .

ENV RUSTFLAGS="-C target-feature=+simd128"
RUN wasm-pack build ledger-wasm --target web --release --out-dir /out-web 2>&1
RUN wasm-pack build ledger-wasm --target nodejs --release --out-dir /out-node 2>&1

# Fix #self imports for both targets (no Node in slim image — use sed)
RUN for dir in /out-web /out-node; do \
      sed -i 's/"main"/"imports": { "#self": ".\/midnight_ledger_wasm.js" },\n  "main"/' "$dir/package.json"; \
    done

# Fix node target: snippets use ESM `import from '#self'` which causes cycles in CJS.
# Convert to pure CJS: deduplicate imports, replace import→require, export→module.exports.
RUN printf '%s\n' 'import re,pathlib,sys' 'for p in sys.argv[1:]:' '  t=pathlib.Path(p).read_text()' '  c=[0]' '  def ri(m):' '    c[0]+=1' "    return\"const wasm=require('../../midnight_ledger_wasm.js');\"if c[0]==1 else''" "  t=re.sub(r\"import \\* as wasm from '[^']+';\\s*\",ri,t)" "  t=re.sub(r'export function (\\w+)',r'module.exports.\\1=function',t)" '  pathlib.Path(p).write_text(t)' > /tmp/fix-snippets.py && \
    find /out-node/snippets -name '*.js' -exec python3 /tmp/fix-snippets.py {} +
