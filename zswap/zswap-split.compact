import CompactStandardLibrary;

struct CoinPreimage {
  sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

struct SplitCoinBindingPreimage {
  sep: Field,
  coin: ShieldedCoinInfo,
  publicKey: ZswapCoinPublicKey,
}

ledger merkleTree: HistoricMerkleTree<32, Bytes<32>>;
ledger nullifiers: Set<Bytes<32>>;
ledger valueCom: JubjubPoint;
ledger contractAddr: ContractAddress;
ledger publicKey: ZswapCoinPublicKey;
ledger coinCommitment: Bytes<32>;
ledger coinBindingTag: Field;
ledger segment: Uint<16>;

export circuit spendSplitUser(
  pk: ZswapCoinPublicKey,
  path: MerkleTreePath<32, Bytes<32>>,
  coin: ShieldedCoinInfo,
  rc: Field,
  nullifier: Bytes<32>
): [] {
  merkleTree.checkRoot(disclose(merkleTreePathRootNoLeafHash<32>(path)));
  const coinCom = persistentHash<CoinPreimage>(
    CoinPreimage {
      sep: "midnight:zswap-cc[v1]",
      info: coin,
      dataType: true,
      data: pk.bytes,
    });
  assert(coinCom == path.leaf, "Path must be to coin commitment");
  coinCommitment = disclose(coinCom);
  coinBindingTag = disclose(transientHash<SplitCoinBindingPreimage>(
    SplitCoinBindingPreimage {
      sep: "midnight:zswap-split-coin[v1]" as Field,
      coin: coin,
      publicKey: pk,
    }));

  nullifiers.insert(disclose(nullifier));

  const colorBase = hashToCurve<[Bytes<32>, Uint<16>]>([coin.color, segment]);
  const pedersenBlinding = ecMulGenerator(rc);
  const pedersenCommit = ecMul(colorBase, coin.value);
  valueCom = disclose(ecAdd(pedersenBlinding, pedersenCommit));
}

export circuit signSplitUser(pk: ZswapCoinPublicKey): [] {
  publicKey = disclose(pk);
}
